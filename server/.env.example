# Copy to your own process environment. Main does not automatically read this file.
WATSON_HOST=127.0.0.1
WATSON_PORT=4319
# WATSON_DB_PATH=/absolute/path/watson.sqlite
# WATSON_PUBLIC_ORIGIN=https://approved-watson-domain.example
# WATSON_ALLOWED_ORIGINS=https://approved-web-app.example

# Optional hidden assigned-prompt inference; personal provider keys remain desktop-local.
# WATSON_ASSISTANT_OPENAI_KEY=<operator-controlled OpenAI key>
# WATSON_ASSISTANT_MODEL=<registered Chat Completions compatible model ID>
# WATSON_ASSISTANT_WEB_MODEL=<registered Responses/web_search compatible model ID for sourced calendar preparation>
# WATSON_ASSISTANT_SMART_MODEL=<registered reasoning model ID; independent of normal model>
# WATSON_ASSISTANT_SMART_REASONING_EFFORT=high
# WATSON_ASSISTANT_SMART_MAX_OUTPUT_TOKENS=25000
# WATSON_ASSISTANT_SMART_WEB_SEARCH=true

# Enterprise provider encryption; generate independently and store outside SQLite.
# WATSON_SECRET_KEY=<32 random bytes encoded as base64>
# WATSON_OIDC_PROVIDERS_JSON=[{"id":"company","orgId":"org UUID","issuer":"https://identity.example.com","clientId":"registered-client","clientSecretEnv":"WATSON_COMPANY_CLIENT_SECRET","domains":["example.com"],"autoProvision":false}]
# WATSON_COMPANY_CLIENT_SECRET=<identity provider secret>

# Stripe is disabled until configured with registered plans and webhook endpoint.
# WATSON_STRIPE_API_VERSION=2026-09-30.endive
# WATSON_STRIPE_SECRET_KEY=<server Stripe key>
# WATSON_STRIPE_WEBHOOK_SECRET=<registered webhook signing secret>
# WATSON_STRIPE_PRICE_IDS=price_example
# WATSON_BILLING_SUCCESS_URL=https://approved-watson-domain.example/billing/success
# WATSON_BILLING_CANCEL_URL=https://approved-watson-domain.example/billing/cancel

# Google and Merge connectors use their own encryption key and registered apps.
# WATSON_CONNECTOR_ENCRYPTION_KEY=<32 random bytes encoded as base64>
# WATSON_GOOGLE_CLIENT_ID=<registered Google OAuth client ID>
# WATSON_GOOGLE_CLIENT_SECRET=<registered Google OAuth secret>
# WATSON_GOOGLE_REDIRECT_URI=https://approved-watson-domain.example/api/v1/connectors/google/callback
# WATSON_MERGE_API_KEY=<Merge API key>
# WATSON_MERGE_REGION=us

# Account verification/recovery are disabled until email delivery is configured.
# Reuses WATSON_SECRET_KEY for AES-GCM encrypted outbox bodies; tokens are hashed separately.
# WATSON_EMAIL_FROM=watson@example.com
# Resend-compatible JSON API transport:
# WATSON_EMAIL_API_KEY=<operator email API key>
# WATSON_EMAIL_API_URL=https://api.resend.com/emails
# Or SMTP-over-TLS transport (TLS and certificate verification are mandatory in normal runtime):
# WATSON_SMTP_HOST=smtp.example.com
# WATSON_SMTP_PORT=465
# WATSON_SMTP_USER=<SMTP account>
# WATSON_SMTP_PASSWORD=<SMTP password>

# Private recording attachments use authenticated encrypted chunks, not JSON/base64.
# WATSON_RECORDING_DIR=/absolute/private/path/recordings
# WATSON_RECORDING_KEY=<32 random bytes encoded as base64; defaults to WATSON_SECRET_KEY>
# WATSON_RECORDING_MAX_BYTES=134217728
